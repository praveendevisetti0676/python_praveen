   "source": [
    "#Calculate List Sum Without sum() using a function\n",
    "def cal_sumof_list(lst):\n",
    "    total = 0\n",
    "    for num in lst:\n",
    "        total += num\n",
    "    return  total\n",
    "list1 = [15,25,30,25,35,40,45,50]\n",
    "sum_of_list = cal_sumof_list(list1)\n",
    "print(\"Sum of list is:\", sum_of_list)\n",
    "\n"
   ]
