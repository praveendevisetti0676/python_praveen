   "source": [
    "#Multiplication Tables from 1 to 10 Using Nested Loops \n",
    "for i in range(1, 11):\n",
    "    print(f\"Multiplication Table for {i}:\")\n",
    "    for j in range(1, 11):\n",
    "        print(f\"{i} x {j} = {i * j}\")\n",
    "    print()  # Print a blank line after each table  \n"
   ]
