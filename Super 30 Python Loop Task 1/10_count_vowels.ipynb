     "text": [
      "Vowel counts: {'e': 3, 'a': 2, 'U': 1, 'i': 3, 'A': 1, 'o': 1, 'E': 1}\n"
     ]
    }
   ],
   "source": [
    "#Count Vowels in a String \n",
    "string = input(\"Enter a string: \")\n",
    "vowels = \"aeiouAEIOU\" \n",
    "count = {}  \n",
    "for char in string:\n",
    "    if char in vowels:\n",
    "        if char in count:\n",
    "            count[char] += 1\n",
    "        else:\n",
    "            count[char] = 1            \n",
    "print(f\"Vowel counts: {count}\")\n"
   ]
  },
