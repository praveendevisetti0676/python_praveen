   "source": [
    "# Find Largest Number Without max() \n",
    "numbers = [12, 7, 9, 20, 33, 42, 8, 15]\n",
    "largest = numbers[0]\n",
    "for n in numbers:\n",
    "    if n > largest: \n",
    "        largest = n\n",
    "print(f\"Largest number: {largest}\")\n"
   ]
  }
