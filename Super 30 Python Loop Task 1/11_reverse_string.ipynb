   "source": [
    "# Reverse a String Using a For Loop \n",
    "string = input(\"Enter a string: \")\n",
    "reversed_string = \"\"\n",
    "for char in string: \n",
    "    reversed_string = char + reversed_string\n",
    "print(f\"Reversed string: {reversed_string}\")"
   ]
  }
 ],
