   "source": [
    "#Calculate Sum of Numbers from 1 to n \n",
    "num= int(input(\"Enter a number: \"))\n",
    "sum= 0\n",
    "for i in range(1, num + 1):\n",
    "    sum += i\n",
    "print(f\"The sum of numbers from 1 to {num} is: {sum}\")"
   ]
