   "source": [
    "#Find Largest Number Using *args \n",
    "def find_largest(*args):\n",
    "    largest = args[0]\n",
    "    for value in args[1:]:\n",
    "        if value > largest: \n",
    "            largest = value\n",
    "    return largest\n",
    "\n",
    "result = find_largest(14, 89, 23, 67, 45)\n",
    "print(\"Largest:\", result)\n",
    "\n",
    "    \n",
    "\n",
    "\n",
    "    "
   ]
  }
