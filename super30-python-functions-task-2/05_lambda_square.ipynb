    "#Calculate Square Using Lambda \n",
    "square = lambda number: number * number\n",
    "\n",
    "number = int(input(\"Enter a number: \"))\n",
    "\n",
    "result = square(number)\n",
    "\n",
    "print(\"Square:\", result)\n",
    "\n"
   ]
