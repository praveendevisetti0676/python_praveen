   "source": [
    "#Calculate Total Using *args \n",
    "def calculate_total(*args):\n",
    "    total = 0\n",
    "    for value in args:\n",
    "        total += value\n",
    "\n",
    "    return total\n",
    "\n",
    "result = calculate_total(10, 25, 30, 40, 55)\n",
    "\n",
    "print(\"Total of all the values:\", result)\n",
    "\n"
   ]
  }
