   "source": [
    "#Square Numbers Using map() and Lambda \n",
    "numbers = [1, 2, 3, 4, 5, 6]\n",
    "\n",
    "squared_numbers  = list(\n",
    "    map(lambda number: number * number, numbers)\n",
    ")\n",
    "\n",
    "print(\"Original numbers:\", numbers)\n",
    "print(\"Squared numbers:\", squared_numbers)\n",
    "\n"
   ]
  }
