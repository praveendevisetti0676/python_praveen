# Create a list of dictionaries
products = [
    {
        "name": "Laptop",
        "price": 70000,
        "brand": "Dell"
    },
    {
        "name": "Phone",
        "price": 40000,
        "brand": "Samsung"
    },
    {
        "name": "Tablet",
        "price": 30000,
        "brand": "Apple"
    }
]

# Print the list of products
print("List of Products:", products)
# print the first product in the list
print("First Product:", products[0])
# Print second product's price
print("Second Product's Price:", products[1]["price"])
# Print third product's brand
print("Third Product's Brand:", products[2]["brand"])
# Change first product's price
products[0]["price"] = 75000
# Print updated first product's price 
print("Updated First Product's Price:", products[0]["price"])
# Add "rating" to the second product
products[1]["rating"] = 4.5
# Print updated second product
print("Updated Second Product:", products[1])
# Add another product manually
new_product = {
    "name": "SmartWatch",
    "price": 20000,
    "brand": "Fitbit"
}
# Append the new product to the list
products.append(new_product)
# Print the final dataset
print("Final Dataset:", products)

