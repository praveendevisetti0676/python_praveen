   "source": [
    "#Sum Numbers Until User Enters 0 \n",
    "sum = 0\n",
    "while True:\n",
    "    num = int(input(\"Enter a number (0 to stop): \"))\n",
    "    print(\"You entered:\", num)\n",
    "    if num == 0:\n",
    "        break\n",
    "    sum += num  \n",
    "print(\"Sum of numbers:\", sum)\n"
   ]
  }
