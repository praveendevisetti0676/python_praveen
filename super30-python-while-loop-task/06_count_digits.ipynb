   "source": [
    "#Count Number of Digits \n",
    "num = int(input(\"Enter a number: \"))\n",
    "input_num = num\n",
    "count = 0\n",
    "while num > 0:\n",
    "    num //= 10\n",
    "    count += 1\n",
    "print(\"Number of digits in\", input_num, \"is\", count)   \n",
    "\n",
    "\n",
    "\n"
   ]
  }
