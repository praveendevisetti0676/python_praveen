   "source": [
    "#Sum of Digits \n",
    "num= int(input(\"Enter a number: \"))\n",
    "input_num = num\n",
    "sum=0\n",
    "while num>0:\n",
    "    digit=num%10\n",
    "    sum+=digit\n",
    "    num//=10    \n",
    "print(\"Sum of digits in\", input_num, \"is\", sum)\n"
   ]
