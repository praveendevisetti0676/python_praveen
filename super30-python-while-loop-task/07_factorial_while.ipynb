   "source": [
    "#Factorial Using while \n",
    "num= int(input(\"Enter a number: \")) \n",
    "original_num = num\n",
    "factorial = 1\n",
    "while num > 0:\n",
    "    factorial *= num\n",
    "    num -= 1\n",
    "print(\"Factorial of\", original_num, \"is\", factorial)\n",
    "\n",
    "\n",
    "    "
   ]
  }
