   "source": [
    "temperatures = [32, 35, 28, 40, 38, 31, 42]\n",
    "# find the average temperature without using sum() \n",
    "avg_temp = 0   \n",
    "for i in temperatures:\n",
    "    avg_temp += i\n",
    "avg_temp /= len(temperatures)   \n",
    "print(\"Average temperature: \", avg_temp)"
   ]
  }
